<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--author 0neBean-->
<!--应用站点绑定表 mapper-->
<!--since 2023-11-03 13:13:49-->
<mapper namespace="com.tkfc.sdk.mapper.GatewayAppSiteBindMapper">

    <sql id="basicFiled">
            t.id,
            t.operator_name,
            t.operator_id,
            t.update_time,
            t.create_time,
            t.is_deleted,
            t.app_id,
            t.site_id
    </sql>

    <sql id="siteFiled">
            d.id,
            d.operator_name,
            d.operator_id,
            d.update_time,
            d.create_time,
            d.is_deleted,
            d.site_name
    </sql>

    <select id="findAllBindSite" resultType="com.tkfc.sdk.pojo.vo.GatewaySiteVo">
        select
        <include refid="siteFiled"/>
        from gateway_site d
        left join gateway_app_site_bind bind on bind.site_id = d.id
        left join gateway_app s on s.id = bind.app_id
        and s.is_deleted = '0'
        and d.is_deleted = '0'
        order by d.id desc
    </select>

    <resultMap id="basicResultMap" type="com.tkfc.sdk.model.GatewayAppSiteBind">
        <id column="id" jdbcType="INTEGER" property="id"/>
        <result column="operator_name" jdbcType="VARCHAR" property="operatorName"/>
        <result column="operator_id" jdbcType="INTEGER" property="operatorId"/>
        <result column="update_time" jdbcType="TIMESTAMP" property="updateTime"/>
        <result column="create_time" jdbcType="TIMESTAMP" property="createTime"/>
        <result column="is_deleted" jdbcType="CHAR" property="isDeleted"/>
        <result column="app_id" jdbcType="INTEGER" property="appId"/>
        <result column="site_id" jdbcType="INTEGER" property="siteId"/>
    </resultMap>


</mapper>
